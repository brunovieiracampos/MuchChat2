# Ambiente de desenvolvimento LOCAL (Docker). Este arquivo é só referência:
# `npm run dev:db` gera o .env.development.local de verdade, com as chaves do Supabase local.
# No `next dev`, o .env.development.local tem prioridade sobre o .env.local (produção).

# Marca o ambiente como desenvolvimento (tira o aviso de "banco de PRODUÇÃO" do painel).
MUCHCHAT_ENV=dev
# Modo de teste: nenhuma DM, resposta ou publicação sai de verdade no Instagram.
DRY_RUN=true

# Supabase local (npx supabase status mostra os valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Redis local com a API do Upstash (docker-compose.dev.yml)
KV_REST_API_URL=http://127.0.0.1:8079
KV_REST_API_TOKEN=muchchat-dev-token

# Chave própria do local (openssl rand -base64 32): os tokens de produção não abrem aqui.
TOKEN_ENCRYPTION_KEY=

# Vazio de propósito: o local não acessa o armazenamento de mídia de produção.
BLOB_READ_WRITE_TOKEN=
