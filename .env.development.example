# Ambiente de desenvolvimento separado da produção.
# Copie para .env.development.local (não vai para o Git). No `next dev` ele tem prioridade sobre o .env.local.

# Marca o ambiente como desenvolvimento: tira o aviso vermelho de "banco de PRODUÇÃO" do painel.
MUCHCHAT_ENV=dev

# Modo de teste: nenhuma DM, resposta ou publicação sai de verdade no Instagram.
DRY_RUN=true

# --- Supabase do projeto de DESENVOLVIMENTO (Settings → API e Settings → Database no painel do Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta (porta 5432), usada só por scripts/dev-db.sh para criar as tabelas
POSTGRES_URL_NON_POOLING=
