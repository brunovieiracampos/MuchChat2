# --- App da Meta (Instagram API com Instagram Login) ---
# "Instagram app ID" e "Instagram app secret" (não são o ID/secret do app Meta).
# O ID abre o login do Instagram; o secret troca o código pelo token e valida a assinatura do webhook.
IG_APP_ID=
IG_APP_SECRET=
# Qualquer string; a mesma do campo "Verify token" do webhook no painel da Meta
IG_VERIFY_TOKEN=
IG_GRAPH_VERSION=v24.0

# --- Supabase (a integração da Vercel preenche) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Só para aplicar as migrações de supabase/migrations com psql
POSTGRES_URL_NON_POOLING=

# Criptografa os tokens da Meta no banco: 32 bytes em base64 (openssl rand -base64 32).
# Trocar a chave invalida os tokens salvos: todo mundo precisa reconectar o Instagram.
TOKEN_ENCRYPTION_KEY=

# --- Redis (Upstash pela Vercel preenche) ---
# No desenvolvimento local, deixe vazio: o Redis de produção tem os dados reais dos clientes.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Cron ---
# A Vercel preenche sozinha e envia na varredura diária; ADMIN_SECRET também vale para chamar /api/cron/sweep à mão
CRON_SECRET=
ADMIN_SECRET=

# true = não envia nada, só registra no log o que faria
DRY_RUN=false
