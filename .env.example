# --- Instagram (Instagram API com Instagram Login) ---
# Token de longa duração gerado no painel do app (Instagram > API setup > Generate token)
IG_ACCESS_TOKEN=
# ID da conta profissional @d.ia.riamente (o painel mostra; ou GET /me?fields=user_id)
IG_USER_ID=
# "Instagram app secret" (NÃO é o app secret do app Meta) — usado para validar a assinatura do webhook
IG_APP_SECRET=
# "Instagram app ID" (mesma tela do app secret) — usado no botão Conectar Instagram
IG_APP_ID=
# Qualquer string; a mesma que você digitar no campo "Verify token" do webhook no painel
IG_VERIFY_TOKEN=
# Versão da Graph API
IG_GRAPH_VERSION=v24.0

# --- Redis (Upstash via Vercel Marketplace preenche KV_REST_API_URL / KV_REST_API_TOKEN) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Segurança das rotas ---
# Senha para /api/admin/* (header Authorization: Bearer <ADMIN_SECRET> ou ?key=)
ADMIN_SECRET=
# A Vercel preenche sozinha e envia no cron
CRON_SECRET=

# true = não envia nada, só registra no log o que faria
DRY_RUN=false
